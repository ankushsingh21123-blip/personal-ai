# Copy to .env.local on the laptop (never commit .env.local, never paste keys in chat)
# GEMINI_API_KEY=  # from Google AI Studio, project AgroX, key 'muse-email-triage-2026-11-10'
# GROQ_API_KEY=    # optional fallback, free at console.groq.com — create it yourself, no card
# OPENAI_API_KEY=  # optional — only if you already have an OpenAI key; the $0 chain works without it
# OPENAI_BASE_URL= # optional — default https://api.openai.com/v1 ; set to ANY OpenAI-compatible endpoint
# OPENAI_MODEL=    # optional — default gpt-4o-mini; set to whatever your key's account supports
# ANTHROPIC_API_KEY= # optional — only if you already have an Anthropic key; the $0 chain works without it
# ANTHROPIC_MODEL=   # optional — default claude-haiku-4-5; set to whatever your key's account supports
# ANTHROPIC_MAX_TOKENS= # optional — default 1024; the Anthropic API requires a max_tokens value
# BRAIN_PROVIDERS= # optional — comma-separated chain order, e.g. gemini,openai,anthropic,groq,ollama
#                  # unset = default order gemini-direct, gemini-vm-helper, groq, ollama.
#                  # Providers with no key are skipped; unknown names are ignored.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL= # optional — a vision model for Ollama screen vision (e.g. llava, qwen2-vl); without it Ollama is skipped for vision
# ANKU_TOKEN=      # leave blank — server generates a long random token on first start and writes it to .env.local
# PORT=3100
# WORKSPACE=/home/ankush/personal-ai  # laptop path; on this VM it defaults to ~/workspace/personal-ai
# --- Phases B–E (14 Nov 2026) — all optional, all $0 ---
# TELEGRAM_BOT_TOKEN=  # from @BotFather; phone-as-remote. No token = Telegram off.
# TELEGRAM_CHAT_ID=    # your chat id — once set, only this chat is answered
# TELEGRAM_ENABLED=no  # set to no to keep Telegram off even with a token
# WHATSAPP_ENABLED=yes # default off; spare number ONLY, never the primary
# WHATSAPP_SPARE_NUMBER_CONFIRMED=yes  # mandatory explicit confirmation before WhatsApp can start
# DESKTOP_AGENT_PORT=3101  # the laptop desktop agent (desktop-agent.js), loopback only
# ADB_PATH=adb         # Android platform-tools adb binary, for phone control
# SYNC_PEER_URL=       # cloud node URL behind Tailscale, e.g. http://100.x.y.z:3100
# SYNC_TOKEN=          # the peer node's ANKU_TOKEN — never commit, never paste in chat
# DISABLE_SCHEDULER=1  # set to 1 to disable the routines tick + outbox drain loop
